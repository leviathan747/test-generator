{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roxsoftware.com/test-generator/schemas/manifest.schema.json",
  "title": "Manifest",
  "description": "A generated manifest artifact recording a build. Accepts versions 1-3; version-added fields are optional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "form_id",
    "generated",
    "generator_version",
    "files",
    "questions"
  ],
  "properties": {
    "manifest_version": {
      "description": "Manifest schema version.",
      "enum": [1, 2, 3]
    },
    "form_id": {
      "description": "Auto-generated 8-hex-digit form identifier.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "generated": {
      "description": "ISO-8601 timestamp with timezone offset.",
      "type": "string"
    },
    "generator_version": {
      "description": "Version of the generator that wrote the manifest.",
      "type": "string"
    },
    "files": {
      "description": "Input files (config, question banks, figures) with MD5 digests.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileEntry"
      }
    },
    "answer_key": {
      "description": "Comma-joined MCQ answer letters (v3+).",
      "type": "string"
    },
    "questions": {
      "description": "Questions in display order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/manifestQuestion"
      }
    },
    "sections": {
      "description": "Echo of the config's section-range filter (v2+).",
      "type": "string"
    },
    "dok_target": {
      "description": "Echo of the config's dok_target (v2+).",
      "type": "number"
    },
    "config": {
      "description": "Legacy v1 field: path to the source config file.",
      "type": ["string", "null"]
    },
    "questions_file": {
      "description": "Legacy v1 field: path to the source question bank.",
      "type": ["string", "null"]
    },
    "figures_dir": {
      "description": "Legacy v1 field: path to the figures directory.",
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "fileEntry": {
      "title": "File entry",
      "description": "An input file digest. v1 manifests use 'path'; v2+ use 'name'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["md5"],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "md5": {
          "type": "string"
        }
      }
    },
    "manifestQuestion": {
      "title": "Manifest question entry",
      "description": "The reduced per-question record stored in a manifest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": ["string", "integer"]
        },
        "choice_order": {
          "description": "Display-position to canonical-index permutation (MCQs).",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "answer": {
          "description": "Correct-choice letter (v3+).",
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dok": {
          "type": "integer"
        }
      }
    }
  }
}
